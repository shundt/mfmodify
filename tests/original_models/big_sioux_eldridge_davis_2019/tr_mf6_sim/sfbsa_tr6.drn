# DRN6 input file
# layer, row, col from GIS
# drain elev is top layer 1 minus 5 ft
# Hk = 0.05 ft/day
# thickness = 1 ft, width = 10 ft from GIS imagery

BEGIN OPTIONS
  AUXILIARY dlen  dwid  dbthk  hk_mult
  AUXMULTNAME hk_mult
  # hk_mult is the multiplication factor on the conductivity term equal to the bed Hk
  # cond is (hk_mult * rlen * rwid) / rbthk
  PRINT_INPUT
  PRINT_FLOWS
  SAVE_FLOWS
  BOUNDNAMES
END OPTIONS

begin dimensions
  MAXBOUND 248
end dimensions

